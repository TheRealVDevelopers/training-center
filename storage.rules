rules_version = '2';

// Member & guest photos. Anyone can READ (photos show on the reception board,
// cards, and member dashboards); only a signed-in user can WRITE (at signup a
// member is authenticated the moment their account is created). Everything else
// is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /members/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /guests/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
